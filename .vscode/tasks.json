{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Slint: Live desktop preview",
      "type": "process",
      "command": "slint-viewer",
      "args": ["--auto-reload", "ui/app.slint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Android: Watch, rebuild, and relaunch",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\watch-android.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
